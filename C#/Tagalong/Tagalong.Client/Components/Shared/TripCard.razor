<article class="card trip-card @(IsSelected ? "card--selected" : "")">

    @* ---------- Cover: stamp + Select / Edit buttons ---------- *@
    <div class="trip-card__cover">

        @if (ShowSelect)
        {
            if (IsSelected)
            {
                if (OnUnselect.HasDelegate)
                {
                    <button type="button" class="trip-card__select trip-card__select--on"
                            title="Unselect" @onclick="OnUnselect">✓ Selected</button>
                }
                else
                {
                    <span class="trip-card__select trip-card__select--on">✓ Selected</span>
                }
            }
            else if (IsNextUp)
            {
                <span class="trip-card__select trip-card__select--next">Next up</span>
            }
            else
            {
                <button type="button" class="trip-card__select" @onclick="OnSelect">○ Select</button>
            }
        }

        <Stamp Label="@Stamp.LabelFor(Trip.Destination, Trip.Name)"
               Color="Stamp.ColorFor(Trip.Id)"
               Size="Stamp.StampSize.Medium" />

        @if (ShowEdit)
        {
            <a class="btn btn--small trip-card__edit" href="@($"trips/{Trip.Id}/edit")">✎ Edit</a>
        }
    </div>

    @* ---------- Name + destination · dates ---------- *@
    <a class="trip-card__title" href="@($"trips/{Trip.Id}/activities")">
        <h2>@Trip.Name</h2>
    </a>

    @if (!string.IsNullOrWhiteSpace(Meta))
    {
        <p class="text-small text-muted">@Meta</p>
    }

    @* ---------- Participants + Invite ---------- *@
    <div class="row row--between">
        <div class="avatar-stack">
            @foreach (var p in Participants.Take(MaxAvatars))
            {
                <Avatar Name="@p.Name" Small="true" />
            }
            @if (Participants.Count > MaxAvatars)
            {
                <span class="trip-card__more">+@(Participants.Count - MaxAvatars)</span>
            }
        </div>

        @if (ShowInvite)
        {
            <a class="btn btn--secondary btn--small" href="@($"trips/{Trip.Id}/invite")">+ Invite</a>
        }
    </div>
</article>

@code {
    
    [Parameter, EditorRequired] public TripDto Trip { get; set; } = default!;

    [Parameter] public bool IsSelected { get; set; }

    [Parameter] public bool ShowSelect { get; set; }

    [Parameter] public bool ShowEdit { get; set; }

    [Parameter] public bool ShowInvite { get; set; }

    [Parameter] public EventCallback OnSelect { get; set; }

    [Parameter] public EventCallback OnUnselect { get; set; }
    
    [Parameter] public bool IsNextUp { get; set; }


    // ----- Helpers -----
    private const int MaxAvatars = 5;

    private List<UserSummaryDto> Participants => Trip.Participants ?? new();
    
    private string Meta => TripFormatting.Meta(Trip);
}