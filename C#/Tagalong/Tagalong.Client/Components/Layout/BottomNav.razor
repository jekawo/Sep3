@using Microsoft.AspNetCore.Components.Routing
@inject SelectedTripState State
@inject NavigationManager Nav
@implements IDisposable

<nav class="bottom-nav" aria-label="Main">
    <a class="bottom-nav__item@(TripsActive ? " active" : "")"
       href="trips"
       aria-current="@(TripsActive ? "page" : null)">
        <span class="bottom-nav__icon"><NavIcon Name="trips" /></span>
        <span>Trips</span>
    </a>

    <a class="bottom-nav__item@(ActivitiesActive ? " active" : "")"
       href="@ActivitiesHref"
       aria-current="@(ActivitiesActive ? "page" : null)">
        <span class="bottom-nav__icon"><NavIcon Name="activities" /></span>
        <span>Activities</span>
    </a>
</nav>

@code {
    private NavSection Section => NavSections.Get(Nav.ToBaseRelativePath(Nav.Uri));

    private bool TripsActive => Section == NavSection.Trips;

    // Never active without a trip – there is no activities page to be on.
    private bool ActivitiesActive => State.SelectedTripId is not null && Section == NavSection.Activities;

    // Falls back to My trips until a trip is known.
    private string ActivitiesHref =>
        State.SelectedTripId is int id ? $"trips/{id}/activities" : "trips";

    protected override void OnInitialized()
    {
        State.OnChange += HandleChange;
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= HandleChange;
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
