<section class="stack">
    <h2>TripSwitcher</h2>
    <p class="text-small text-muted">Click "Change ▾" and pick another trip – the name updates and the list closes.</p>

    <div style="max-width: 480px" class="stack">
        <TripSwitcher Trips="trips" SelectedTripId="selectedId" OnTripSelected="t => selectedId = t.Id" />
        <p class="text-small text-muted">Selected trip id: @selectedId</p>
    </div>

    <p class="text-small text-muted">Only one trip – no "Change" button</p>
    <div style="max-width: 480px">
        <TripSwitcher Trips="trips.Take(1).ToList()" SelectedTripId="trips[0].Id" />
    </div>
</section>

@code {
    private int? selectedId = 1;

    // Soonest first, like the real page will sort them
    private List<TripDto> trips = new()
    {
        new TripDto { Id = 1, Name = "Berlin juleshopping", Destination = "Berlin, Tyskland",
                      StartDate = new DateOnly(2026, 12, 5), EndDate = new DateOnly(2026, 12, 7) },
        new TripDto { Id = 2, Name = "Roadtrip Norge", Destination = "Bergen, Norge",
                      StartDate = new DateOnly(2027, 6, 28), EndDate = new DateOnly(2027, 7, 4) },
        new TripDto { Id = 4, Name = "Weekend somewhere" }   // no dates → no date line
    };
}
