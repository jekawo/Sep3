@* Gallery examples for TripCard – Components/Pages/Dev/Examples/ *@

<section class="stack">
    <h2>TripCard</h2>

    <div class="card-grid">
        <div class="stack">
            <p class="text-small text-muted">Click Select / Selected to try it</p>
            <TripCard Trip="berlin" IsSelected="@(selectedId == berlin.Id)"
                      ShowSelect="true" ShowEdit="true" ShowInvite="true"
                      OnSelect="() => selectedId = berlin.Id"
                      OnUnselect="() => selectedId = null" />
        </div>

        <div class="stack">
            <p class="text-small text-muted">Click Select / Selected to try it</p>
            <TripCard Trip="norge" IsSelected="@(selectedId == norge.Id)"
                      ShowSelect="true" ShowEdit="true" ShowInvite="true"
                      OnSelect="() => selectedId = norge.Id"
                      OnUnselect="() => selectedId = null" />
        </div>

        <div class="stack">
            <p class="text-small text-muted">No buttons (invite pages)</p>
            <TripCard Trip="kobenhavn" />
        </div>

        <div class="stack">
            <p class="text-small text-muted">No destination or dates, one person</p>
            <TripCard Trip="empty" ShowSelect="true" ShowEdit="true" ShowInvite="true" />
        </div>
    </div>
</section>

@code {
    private int? selectedId = 1;

    // Fake data – no API needed.

    private TripDto berlin = new TripDto
    {
        Id = 1,
        Name = "Berlin juleshopping",
        Destination = "Berlin, Tyskland",
        StartDate = new DateOnly(2026, 12, 5),
        EndDate = new DateOnly(2026, 12, 7),
        OrganizerId = 1,
        Participants = new()
        {
            new UserSummaryDto { Id = 1, Name = "Katalina Haritova" },
            new UserSummaryDto { Id = 2, Name = "Emre Kekec" },
            new UserSummaryDto { Id = 3, Name = "Hatice Cevirici" }
        }
    };

    // 7 people → shows 5 avatars + "+2"; dates across two months
    private TripDto norge = new TripDto
    {
        Id = 2,
        Name = "Roadtrip Norge",
        Destination = "Bergen, Norge",
        StartDate = new DateOnly(2027, 6, 28),
        EndDate = new DateOnly(2027, 7, 4),
        Budget = 12000,
        OrganizerId = 2,
        Participants = new()
        {
            new UserSummaryDto { Id = 2, Name = "Emre Kekec" },
            new UserSummaryDto { Id = 4, Name = "Jesper Wohlgemuth" },
            new UserSummaryDto { Id = 5, Name = "Rumeysa Erdogan" },
            new UserSummaryDto { Id = 1, Name = "Katalina Haritova" },
            new UserSummaryDto { Id = 3, Name = "Hatice Cevirici" },
            new UserSummaryDto { Id = 6, Name = "Ada Example" },
            new UserSummaryDto { Id = 7, Name = "Bo Example" }
        }
    };

    private TripDto kobenhavn = new TripDto
    {
        Id = 3,
        Name = "Weekend i København",
        Destination = "København, Danmark",
        StartDate = new DateOnly(2027, 6, 12),
        EndDate = new DateOnly(2027, 6, 14),
        OrganizerId = 1,
        Participants = new()
        {
            new UserSummaryDto { Id = 1, Name = "Katalina Haritova" },
            new UserSummaryDto { Id = 2, Name = "Emre Kekec" },
            new UserSummaryDto { Id = 3, Name = "Hatice Cevirici" },
            new UserSummaryDto { Id = 4, Name = "Jesper Wohlgemuth" }
        }
    };

    // No destination → stamp uses the trip name; no dates → no meta line
    private TripDto empty = new TripDto
    {
        Id = 4,
        Name = "Weekend somewhere",
        OrganizerId = 1,
        Participants = new() { new UserSummaryDto { Id = 1, Name = "Katalina Haritova" } }
    };
}
