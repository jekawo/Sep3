@* Gallery examples for TripCard – Components/Pages/Dev/Examples/ *@

<section class="stack">
    <h2>TripCard</h2>

    <div class="card-grid">
        <div class="stack">
            <p class="text-small text-muted">Selected, all buttons (My trips)</p>
            <TripCard Trip="berlin" IsSelected="true" ShowSelect="true" ShowEdit="true" ShowInvite="true" />
        </div>

        <div class="stack">
            <p class="text-small text-muted">Not selected – click "Select" to try it</p>
            <TripCard Trip="norge" IsSelected="@(selectedId == norge.Id)"
                      ShowSelect="true" ShowEdit="true" ShowInvite="true"
                      OnSelect="() => selectedId = norge.Id" />
        </div>

        <div class="stack">
            <p class="text-small text-muted">No buttons (invite pages)</p>
            <TripCard Trip="kobenhavn" />
        </div>

        <div class="stack">
            <p class="text-small text-muted">No destination or dates, one person</p>
            <TripCard Trip="empty" ShowSelect="true" ShowEdit="true" ShowInvite="true" />
        </div>
    </div>
</section>

@code {
    private int? selectedId;

    // Fake data – no API needed.
    // TripDto(Id, Name, Destination, StartDate, EndDate, Budget, OrganizerId, Participants)
    // UserSummaryDto(Id, Name)

    private TripDto berlin = new(1, "Berlin juleshopping", "Berlin, Tyskland",
        new DateOnly(2026, 12, 5), new DateOnly(2026, 12, 7), null, 1,
        new()
        {
            new(1, "Katalina Haritova"),
            new(2, "Emre Kekec"),
            new(3, "Hatice Cevirici")
        });

    // 7 people → shows 5 avatars + "+2"; dates across two months
    private TripDto norge = new(2, "Roadtrip Norge", "Bergen, Norge",
        new DateOnly(2027, 6, 28), new DateOnly(2027, 7, 4), 12000, 2,
        new()
        {
            new(2, "Emre Kekec"),
            new(4, "Jesper Wohlgemuth"),
            new(5, "Rumeysa Erdogan"),
            new(1, "Katalina Haritova"),
            new(3, "Hatice Cevirici"),
            new(6, "Ada Example"),
            new(7, "Bo Example")
        });

    private TripDto kobenhavn = new(3, "Weekend i København", "København, Danmark",
        new DateOnly(2027, 6, 12), new DateOnly(2027, 6, 14), null, 1,
        new()
        {
            new(1, "Katalina Haritova"),
            new(2, "Emre Kekec"),
            new(3, "Hatice Cevirici"),
            new(4, "Jesper Wohlgemuth")
        });

    // No destination → stamp uses the trip name; no dates → no meta line
    private TripDto empty = new(4, "Weekend somewhere", null, null, null, null, 1,
        new() { new(1, "Katalina Haritova") });
}
