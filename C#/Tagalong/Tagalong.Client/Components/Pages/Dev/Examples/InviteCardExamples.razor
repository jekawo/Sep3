    protected override void OnInitialized() => Reset();

    private void Reset()
    {
        invites = new()
        {
            new InviteDto
            {
                Id = 1,
                Trip = new TripDto
                {
                    Id = 3,
                    Name = "Weekend i København",
                    Destination = "København, Danmark",
                    StartDate = new DateOnly(2027, 6, 12),
                    EndDate = new DateOnly(2027, 6, 14),
                    OrganizerId = 1,
                    Participants = new() { new UserSummaryDto { Id = 1, Name = "Katalina Haritova" } }
                },
                InvitedBy = new UserSummaryDto { Id = 1, Name = "Katalina" },
                InvitedEmailOrUsername = "you@example.com",
