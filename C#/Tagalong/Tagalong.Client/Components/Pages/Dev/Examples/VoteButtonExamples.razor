<section class="stack">
    <h2>VoteButton</h2>

    <p class="text-small text-muted">Both states</p>
    <div class="row">
        <VoteButton Count="3" HasVoted="false" />
        <VoteButton Count="4" HasVoted="true" />
        <VoteButton Count="0" HasVoted="false" />
        <VoteButton Count="3" Disabled="true" />
    </div>

    <p class="text-small text-muted">Click to toggle (count goes up and down, like the real thing)</p>
    <div class="row">
        <VoteButton Count="count" HasVoted="hasVoted" OnToggle="Toggle" />
    </div>
</section>

@code {
    private int count = 3;
    private bool hasVoted;

    private void Toggle()
    {
        hasVoted = !hasVoted;
        count += hasVoted ? 1 : -1;
    }
}
