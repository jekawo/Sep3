<section class="stack">
    <h2>FormField</h2>

    <EditForm Model="example" class="stack" style="max-width: 400px">
        <DataAnnotationsValidator />

        <FormField Label="Required" Id="ex-req" Required="true" For="() => example.Name">
            <InputText id="ex-req" @bind-Value="example.Name" placeholder="Leave empty and press Check" />
        </FormField>

        <FormField Label="Optional with hint" Id="ex-opt" For="() => example.Destination"
                   Hint="Everyone in the trip can see the destination.">
            <InputText id="ex-opt" @bind-Value="example.Destination" placeholder="City or country" />
        </FormField>

        <FormField Label="No marker (log in)" Id="ex-none" ShowOptional="false" For="() => example.Destination">
            <InputText id="ex-none" @bind-Value="example.Destination" placeholder="you@example.com" />
        </FormField>

        <FormField Label="Text area" Id="ex-area" For="() => example.Destination">
            <InputTextArea id="ex-area" @bind-Value="example.Destination" placeholder="What is it and why is it fun?" />
        </FormField>

        <button type="submit" class="btn btn--secondary">Check</button>
    </EditForm>
</section>

@code {
    private ExampleModel example = new();

    private class ExampleModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter a name.")]
        public string? Name { get; set; }
        public string? Destination { get; set; }
    }
}