@page "/Login"
<h3>Login</h3>

<div class="login-container">
<div class="travel-section">

<div class="travel-card bali">
    <h3>BALI</h3>
    <div class="card-image"></div>
</div>
<div class="travel-card copenhagen">
    <h3>KØBENHAVN</h3>
    <div class="card-image"></div>
</div>

<div class="travel-card rome">
    <h3>ROMA</h3>
    <div class="card-image"></div>
</div>

<div class="travel-card norway">
    <h3>NORGE</h3>
    <div class="card-image"></div>
</div>

</div>

<div class="login-section">

    <div class="logo">
        <span class="logo-icon">t.</span>
        <h1>tagalong</h1>
    </div>

    <p>Plan trips together – vote, split &amp; go.</p>

    <form class="login-form">

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email"
                   id="email"
                   placeholder="you@example.com" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password"
                   id="password"
                   placeholder="••••••••" />
        </div>

        <button type="button" class="login-button">
            Log in
        </button>

    </form>

    <button type="button" class="create-account">
        Create account
    </button>

</div>

</div>

