@page "/Login"
@layout AuthLayout

<div class="login-container">
<div class="travel-section">

    <Stamp Label="BALI"
           Color="Stamp.StampColor.Lime"
           Size="Stamp.StampSize.Large"
           Rotation="6" />
    
    <Stamp Label="KØBENHAVEN"
           Color="Stamp.StampColor.Cyan"
           Size="Stamp.StampSize.Large"
           Rotation="-4" />
    
    <Stamp Label="ROMA"
           Color="Stamp.StampColor.Pink"
           Size="Stamp.StampSize.Large"
           Rotation="-8" />

    <Stamp Label="NORGE"
           Color="Stamp.StampColor.Lime"
           Size="Stamp.StampSize.Large"
           Rotation="5" />
</div>

<div class="login-section">

    <div class="logo">
        <span class="logo-icon">t.</span>
        <h1>tagalong</h1>
    </div>

    <p>Plan trips together – vote, split &amp; go.</p>

    <form class="login-form">

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email"
                   id="email"
                   placeholder="you@example.com" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password"
                   id="password"
                   placeholder="••••••••" />
        </div>

        <button type="button" class="login-button">
            Log in
        </button>

    </form>

    <button type="button" class="create-account">
        Create account
    </button>

</div>

</div>

