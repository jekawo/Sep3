@page "/login"
@layout AuthLayout

<div class="login-container">

    <div class="travel-section">

        <Stamp Label="BALI"
               Color="Stamp.StampColor.Lime"
               Size="Stamp.StampSize.Large"
               Rotation="6" />

        <Stamp Label="KØBENHAVN"
               Color="Stamp.StampColor.Cyan"
               Size="Stamp.StampSize.Large"
               Rotation="-4" />

        <Stamp Label="ROMA"
               Color="Stamp.StampColor.Pink"
               Size="Stamp.StampSize.Large"
               Rotation="-8" />

        <Stamp Label="NORGE"
               Color="Stamp.StampColor.Lime"
               Size="Stamp.StampSize.Large"
               Rotation="5" />

    </div>

    <div class="login-section card">

        <div class="logo">
            <span class="logo-icon">t.</span>
            <h1>tagalong</h1>
        </div>

        <p>Plan trips together – vote, split &amp; go.</p>

        <form class="login-form stack">

            <FormField TValue="string"
                       Label="Email"
                       Id="email"
                       ShowOptional="false">

                <input type="email"
                       id="email"
                       placeholder="you@example.com"
                       autocomplete="email" />

            </FormField>

            <FormField TValue="string"
                       Label="Password"
                       Id="password"
                       ShowOptional="false">

                <input type="password"
                       id="password"
                       placeholder="••••••••"
                       autocomplete="current-password" />

            </FormField>

            <button type="button" class="btn btn--primary btn--block">
                Log in
            </button>

        </form>

        <a href="/register" class="btn btn--ghost btn--block">
            Create account
        </a>

    </div>

</div>


